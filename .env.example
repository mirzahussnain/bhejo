# Bhejo Environment Configuration
# IMPORTANT: Never commit actual secret keys to git.

# Client-safe Supabase configuration (Publishable)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only Supabase configuration (Secret - NEVER EXPOSE TO CLIENT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Storage configuration
STORAGE_BUCKET=documents

# Optional application URL (defaults dynamically to request host)
NEXT_PUBLIC_APP_URL=http://localhost:3000
